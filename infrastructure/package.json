{
  "name": "zladovce-infrastructure",
  "version": "0.1.0",
  "private": true,
  "description": "AWS CDK application for the Zladovce e-commerce platform",
  "bin": {
    "zladovce": "bin/zladovce.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "test": "jest",
    "cdk": "cdk",
    "synth": "cdk synth",
    "synth:dev": "cdk synth -c env=dev --quiet",
    "synth:staging": "cdk synth -c env=staging --quiet",
    "synth:prod": "cdk synth -c env=prod --quiet",
    "synth:all": "npm run synth:dev && npm run synth:staging && npm run synth:prod",
    "nag": "cdk synth -c env=dev -c nag=true --quiet"
  },
  "dependencies": {
    "aws-cdk-lib": "2.275.0",
    "constructs": "^10.5.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^24.0.0",
    "aws-cdk": "2.1147.0",
    "cdk-nag": "3.0.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3"
  }
}
